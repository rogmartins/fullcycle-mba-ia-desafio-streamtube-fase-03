# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=30000
QUEUE_WORKER_CONCURRENCY=1
SWEEP_INTERVAL_MINUTES=15
SWEEP_STALE_UPLOAD_MINUTES=60
SWEEP_ABANDON_DAYS=7
SWEEP_STALE_PROCESSING_MINUTES=60

# Storage (MinIO / S3)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=streamtube-app
STORAGE_SECRET_KEY=streamtube-app-secret
STORAGE_VIDEO_BUCKET=videos
STORAGE_THUMBNAIL_BUCKET=thumbnails
UPLOAD_PART_SIZE_BYTES=52428800
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_MAX_OPEN_PER_CHANNEL=5
UPLOAD_PART_URL_TTL_SECONDS=3600
PLAYBACK_URL_TTL_SECONDS=28800
DOWNLOAD_URL_TTL_SECONDS=900
WORKER_SOURCE_URL_TTL_SECONDS=7200

# MinIO root admin credentials (dev only, used by minio/minio-init services)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-secret

# Object storage CORS (consumed by minio-init only, not part of app config)
APP_CORS_ORIGIN=http://localhost:3001

# Processing (FFmpeg)
FFPROBE_TIMEOUT_MS=120000
FFMPEG_THUMBNAIL_TIMEOUT_MS=300000
THUMBNAIL_OFFSET_PERCENT=10
THUMBNAIL_MAX_WIDTH=1280
THUMBNAIL_JPEG_QUALITY=3
